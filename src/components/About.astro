---
import Photo from "./Photo.astro";
import aboutImg from "../assets/stock/about-hands.jpg";
import { site } from "../site.config";
---

<section id="about" class="about" aria-labelledby="about-title">
  <div class="wrap about__inner">
    <div class="about__media" data-parallax-frame>
      <Photo
        src={aboutImg}
        alt="Руки за работой: нитки, кружево и булавки на столе"
        widths={[480, 720, 960, 1280, 1600]}
        sizes="(min-width: 60rem) 42vw, 92vw"
        class="about__photo"
        imgClass="about__img"
      />
    </div>
    <div class="about__copy">
      <h2 id="about-title" class="display about__title" data-split>Мастерская</h2>
      <p class="about__text" data-reveal>
        {site.name} — небольшая мастерская в Екатеринбурге. Я шью бельё по индивидуальным меркам: без
        размерной сетки и без склада готовых вещей. Каждую вещь веду от замера до примерки.
      </p>
      <p class="about__text about__text--name" data-reveal>
        Название — от слова «сантиметр»: всё, что я шью, строится по вашим сантиметрам.
      </p>
    </div>
  </div>
</section>

<style>
  .about {
    padding-block: var(--section);
    background: var(--paper-2);
  }

  .about__inner {
    display: grid;
    gap: 3rem;
  }

  .about__media {
    overflow: hidden;
  }

  .about__media :global(.about__photo) {
    aspect-ratio: 4 / 5;
  }

  .about__title {
    font-size: var(--step-4);
  }

  .about__text {
    margin-top: 1.5rem;
    max-width: var(--measure);
    color: var(--stone);
    font-size: var(--step-1);
    line-height: 1.6;
  }

  .about__text--name {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-2);
    line-height: 1.3;
    color: var(--ink);
  }

  @media (min-width: 60rem) {
    .about__inner {
      grid-template-columns: 5fr 1fr 6fr;
      align-items: center;
    }

    .about__media {
      grid-column: 1;
    }

    .about__copy {
      grid-column: 3;
    }
  }
</style>
