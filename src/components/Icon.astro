---
// One drawn icon set: 1.5px stroke, round joins, 24px grid.
interface Props {
  name: "telegram" | "arrow-right" | "arrow-down" | "phone" | "vk" | "menu" | "close" | "pin" | "message" | "max" | "avito" | "sms" | "plus";
  class?: string;
}
const { name, class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === "telegram" && (
    <>
      <path d="M21.5 3.5 2.8 10.7c-.9.4-.9 1.6 0 1.9l4.6 1.5 1.8 5.6c.2.7 1.1.9 1.6.4l2.6-2.5 4.7 3.5c.6.4 1.4.1 1.6-.6L22.9 5c.2-1-.6-1.8-1.4-1.5Z" />
      <path d="m7.4 14.1 10.3-7.2-8.4 8.9" />
    </>
  )}
  {name === "arrow-right" && <path d="M4 12h15m-5-5 5 5-5 5" />}
  {name === "arrow-down" && <path d="M12 4v15m-5-5 5 5 5-5" />}
  {name === "plus" && <path d="M12 5v14M5 12h14" />}
  {name === "phone" && (
    <path d="M5.2 3.8h3l1.6 4.1-2 1.3a11.6 11.6 0 0 0 7 7l1.3-2 4.1 1.6v3a1.9 1.9 0 0 1-2 1.9C10.4 20.2 3.8 13.6 3.3 5.8a1.9 1.9 0 0 1 1.9-2Z" />
  )}
  {name === "vk" && (
    <path d="M3 7.5h3.1c.9 3.3 2.4 5.4 3.9 5.9V7.5h2.8v3.3c1.5-.2 3-1.9 3.6-3.3h2.8c-.5 2.1-2 3.8-3.2 4.6 1.2.6 3 2.1 3.7 4.4h-3.1c-.6-1.6-2-3-3.8-3.2v3.2h-.4C7.1 16.5 3.4 12.8 3 7.5Z" />
  )}
  {name === "menu" && <path d="M3.5 8h17M3.5 16h17" />}
  {name === "close" && <path d="m5.5 5.5 13 13m0-13-13 13" />}
  {name === "message" && (
    <path d="M4.5 5.5h15a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H10l-4.5 3.5v-3.5h-1a1 1 0 0 1-1-1v-9a1 1 0 0 1 1-1Z" />
  )}
  {name === "sms" && (
    <>
      <path d="M4.5 5.5h15a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H10l-4.5 3.5v-3.5h-1a1 1 0 0 1-1-1v-9a1 1 0 0 1 1-1Z" />
      <path d="M8.5 11h.01M12 11h.01M15.5 11h.01" />
    </>
  )}
  {name === "max" && (
    <>
      <circle cx="12" cy="12" r="8.5" />
      <path d="M8 15.5V8.8l4 4.2 4-4.2v6.7" />
    </>
  )}
  {name === "avito" && (
    <>
      <circle cx="8" cy="8" r="2.6" />
      <circle cx="16.5" cy="9.5" r="3.6" />
      <circle cx="9.5" cy="16" r="3.2" />
      <circle cx="17" cy="17.5" r="1.8" />
    </>
  )}
  {name === "pin" && (
    <>
      <path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z" />
      <circle cx="12" cy="10" r="2.3" />
    </>
  )}
</svg>
