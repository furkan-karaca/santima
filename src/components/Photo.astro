---
// A photograph with an optional placeholder tag. While site.placeholderPhotos
// is true, every stock image says so on its face.
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import { site } from "../site.config";

interface Props {
  src: ImageMetadata;
  alt: string;
  widths: number[];
  sizes: string;
  class?: string;
  imgClass?: string;
  eager?: boolean;
  stock?: boolean;
}

const {
  src,
  alt,
  widths,
  sizes,
  class: className,
  imgClass,
  eager = false,
  stock = true,
} = Astro.props;
---

<div class:list={["photo", className]}>
  <Picture
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizes}
    formats={["avif", "webp"]}
    fallbackFormat="jpg"
    loading={eager ? "eager" : "lazy"}
    fetchpriority={eager ? "high" : "auto"}
    decoding="async"
    class={imgClass}
  />
  {stock && site.placeholderPhotos && <span class="ph-tag">фото-заглушка</span>}
</div>

<style>
  .photo {
    position: relative;
    overflow: hidden;
    background: var(--paper-2);
  }

  .photo :global(picture),
  .photo :global(img) {
    width: 100%;
    height: 100%;
  }

  .photo :global(img) {
    object-fit: cover;
  }
</style>
