---
import Photo from "./Photo.astro";
import Icon from "./Icon.astro";
import heroImg from "../assets/stock/hero-lace.jpg";
---

<section class="hero on-ink" aria-labelledby="hero-title" data-hero>
  <div class="hero__media" data-hero-media>
    <Photo
      src={heroImg}
      alt="Кружевное бельё крупным планом"
      widths={[640, 960, 1280, 1920, 2400]}
      sizes="100vw"
      eager
      class="hero__photo"
      imgClass="hero__img"
    />
    <div class="hero__scrim" aria-hidden="true"></div>
  </div>

  <div class="hero__copy wrap">
    <h1 id="hero-title" class="display hero__title" data-hero-title>
      Бельё<br /> по <em>вашим</em> меркам
    </h1>
    <p class="hero__lede" data-hero-fade>
      Снимаю мерки лично и шью каждую вещь под вас. Мастерская в Екатеринбурге.
    </p>
    <div class="hero__actions" data-hero-fade>
      <a class="btn btn--light hero__cta" href="#contact">
        Записаться на мерки
        <Icon name="arrow-right" />
      </a>
      <a class="text-link" href="#process">
        Как проходит пошив
        <Icon name="arrow-down" />
      </a>
    </div>
  </div>

  <div class="hero__cue" aria-hidden="true" data-hero-fade>
    <span class="hero__cue-line"></span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    min-height: 100svh;
    background: var(--ink);
    color: var(--paper);
    overflow: clip;
  }

  .hero__media {
    position: relative;
    height: 46svh;
    min-height: 19rem;
    overflow: hidden;
  }

  .hero__media :global(.hero__photo) {
    position: absolute;
    inset: 0;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(13 27 42 / 1) 0%, rgb(13 27 42 / 0) 38%);
    pointer-events: none;
  }

  .hero__copy {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    padding-block: 0.25rem 2.5rem;
  }

  .hero__title {
    font-size: var(--step-4);
  }

  .hero__lede {
    max-width: 28rem;
    font-size: var(--step-0);
    color: rgb(224 225 221 / 0.82);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
    margin-top: 0.5rem;
  }

  .hero__cta {
    flex: 1 1 100%;
  }

  .hero__cue {
    display: none;
  }

  @media (min-width: 48rem) {
    .hero {
      min-height: 100svh;
    }

    .hero__media {
      position: absolute;
      inset: 0;
      height: auto;
    }

    .hero__scrim {
      background:
        linear-gradient(to top, rgb(13 27 42 / 0.78) 0%, rgb(13 27 42 / 0.35) 34%, rgb(13 27 42 / 0) 60%),
        linear-gradient(to right, rgb(13 27 42 / 0.72) 0%, rgb(13 27 42 / 0.5) 38%, rgb(13 27 42 / 0) 68%);
    }

    .hero__copy {
      align-self: end;
      padding-block: 0 clamp(3rem, 8vh, 6rem);
    }

    .hero__cta {
      flex: 0 0 auto;
    }

    .hero__cue {
      position: absolute;
      right: var(--gutter);
      bottom: clamp(3rem, 8vh, 6rem);
      z-index: 2;
      display: block;
      width: 1px;
      height: 5rem;
      background: rgb(224 225 221 / 0.25);
      overflow: hidden;
    }

    .hero__cue-line {
      position: absolute;
      inset: 0;
      background: var(--accent-on-ink);
      transform-origin: 50% 0;
      animation: cue 2.4s var(--ease-out) infinite;
    }
  }

  @keyframes cue {
    0% {
      transform: scaleY(0);
      transform-origin: 50% 0;
    }
    50% {
      transform: scaleY(1);
      transform-origin: 50% 0;
    }
    51% {
      transform-origin: 50% 100%;
    }
    100% {
      transform: scaleY(0);
      transform-origin: 50% 100%;
    }
  }
</style>
